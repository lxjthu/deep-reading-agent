# 无密钥配置样例。完整填写说明见同目录 .env 或测试规划第 9 节。
MIMO_API_KEY=
MIMO_API_MODE=auto
MIMO_PAYG_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LUNA_EXECUTION_MODE=codex_native
LUNA_TARGET_MODEL=gpt-5.6-luna
DRA_COMPARE_PROVIDERS=mimo,deepseek,luna
DRA_COMPARE_INPUT_DIR=./inputs
DRA_COMPARE_OUTPUT_DIR=./workspaces/comparison
DRA_COMPARE_MAX_PAPERS_PER_SINGLE_TASK=1
DRA_COMPARE_REPEATS=1
DRA_COMPARE_API_CONCURRENCY=1
DRA_COMPARE_API_TIMEOUT_SECONDS=180
DRA_COMPARE_API_MAX_RETRIES=1
DRA_COMPARE_API_MAX_OUTPUT_TOKENS=8000
DRA_API_THINKING=disabled
